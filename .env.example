# Any of these token variables works (CLOUDFLARE_API_TOKEN is the canonical one):
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_TOKEN=
# Legacy global key auth instead of a token:
# CLOUDFLARE_API_KEY=
# CLOUDFLARE_EMAIL=
# Defaults (id or name); can also live in a profile: `cmdflare config set account_id ...`
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
